#!/bin/csh -f

# Simulation job submitted by verilog_sub.
# The DPI library is built by run_verilog_sub.sh; no external .so is assumed.

set script_dir = `dirname "$0"`
set script_dir = `cd "$script_dir" && pwd`

if ($?CORE_ROOT) then
  set core_root = "$CORE_ROOT"
else
  set core_root = `cd "$script_dir/../.." && pwd`
endif

setenv CORE_ROOT "$core_root"
setenv RTL_DIR "${CORE_ROOT}/rtl"
setenv TB_DIR "${CORE_ROOT}/tb"
setenv XCELIUM_DIR "${CORE_ROOT}/sim/xcelium"

if ($?HTIF_BUILD_DIR) then
  set build_dir = "$HTIF_BUILD_DIR"
else
  set build_dir = "${XCELIUM_DIR}/out"
endif
if ($?XCELIUM_SNAPSHOT) then
  set snapshot = "$XCELIUM_SNAPSHOT"
else
  set snapshot = "rv_soc_htif_dpi_tb_snapshot"
endif

set binary = ""
set sv_lib = "${build_dir}/libcore_htif_dpi.so"
set timeout_cycles = "2000000"
set heartbeat_cycles = "100000"
set elf_verify = "1"
set trace_file = "${build_dir}/commit_trace.csv"
set fsdb_enable = "1"
set fsdb_file = "${build_dir}/waves.fsdb"
set fsdb_dump_mda = "0"
set fsdb_flush_cycles = "100000"
set fsdb_pli = "auto"

foreach arg ($argv)
  if ("$arg" =~ "-BINARY=*") then
    set binary = `echo "$arg" | sed 's/-BINARY=//'`
  else if ("$arg" =~ "-SV_LIB=*") then
    set sv_lib = `echo "$arg" | sed 's/-SV_LIB=//'`
  else if ("$arg" =~ "-TIMEOUT_CYCLES=*") then
    set timeout_cycles = `echo "$arg" | sed 's/-TIMEOUT_CYCLES=//'`
  else if ("$arg" =~ "-HEARTBEAT_CYCLES=*") then
    set heartbeat_cycles = `echo "$arg" | sed 's/-HEARTBEAT_CYCLES=//'`
  else if ("$arg" =~ "-ELF_VERIFY=*") then
    set elf_verify = `echo "$arg" | sed 's/-ELF_VERIFY=//'`
  else if ("$arg" =~ "-TRACE_FILE=*") then
    set trace_file = `echo "$arg" | sed 's/-TRACE_FILE=//'`
  else if ("$arg" =~ "-FSDB_ENABLE=*") then
    set fsdb_enable = `echo "$arg" | sed 's/-FSDB_ENABLE=//'`
  else if ("$arg" =~ "-FSDB_FILE=*") then
    set fsdb_file = `echo "$arg" | sed 's/-FSDB_FILE=//'`
  else if ("$arg" =~ "-FSDB_DUMP_MDA=*") then
    set fsdb_dump_mda = `echo "$arg" | sed 's/-FSDB_DUMP_MDA=//'`
  else if ("$arg" =~ "-FSDB_FLUSH_CYCLES=*") then
    set fsdb_flush_cycles = `echo "$arg" | sed 's/-FSDB_FLUSH_CYCLES=//'`
  else if ("$arg" =~ "-FSDB_PLI=*") then
    set fsdb_pli = `echo "$arg" | sed 's/-FSDB_PLI=//'`
  endif
end

if ("$binary" == "" || ! -f "$binary") then
  echo "ERROR: ELF file was not found: $binary"
  echo "Pass -BINARY=/absolute/path/program.elf to verilog_sub."
  exit 2
endif
if (! -f "$sv_lib") then
  echo "ERROR: DPI shared library was not found: $sv_lib"
  echo "Run run_verilog_sub.sh so the repository DPI library is built first."
  exit 2
endif

if ($?XCELIUM_ENV_CSH) then
  set xcelium_env_csh = "$XCELIUM_ENV_CSH"
else
  set xcelium_env_csh = "/user/vtsw/Cadence/XCELIUM/23.09-s009/gcc93_env64.csh"
endif
if (-f "$xcelium_env_csh") then
  source "$xcelium_env_csh"
else
  which xrun >& /dev/null
  if ($status != 0) then
    echo "ERROR: Xcelium environment file and xrun were not found."
    echo "Set XCELIUM_ENV_CSH to the server's gcc*_env64.csh file."
    exit 2
  endif
endif

mkdir -p "$build_dir"
set fsdb_opts = ()
set fsdb_plusargs = ()
if ("$fsdb_enable" == "1") then
  if ("$fsdb_pli" == "auto") then
    if ($?VERDI_HOME) then
      foreach candidate ( \
        "$VERDI_HOME/share/PLI/XCELIUM/LINUX64/boot/debpli" \
        "$VERDI_HOME/share/PLI/XCELIUM/LINUX64/boot/debpli.so" \
        "$VERDI_HOME/share/PLI/IUS/LINUX64/boot/debpli" \
        "$VERDI_HOME/share/PLI/IUS/LINUX64/boot/debpli.so" )
        if (-e "$candidate") then
          set fsdb_pli = "$candidate"
          break
        endif
      end
    endif
    if ("$fsdb_pli" == "auto" && $?NOVAS_HOME) then
      foreach candidate ( \
        "$NOVAS_HOME/share/PLI/XCELIUM/LINUX64/boot/debpli" \
        "$NOVAS_HOME/share/PLI/XCELIUM/LINUX64/boot/debpli.so" \
        "$NOVAS_HOME/share/PLI/IUS/LINUX64/boot/debpli" \
        "$NOVAS_HOME/share/PLI/IUS/LINUX64/boot/debpli.so" )
        if (-e "$candidate") then
          set fsdb_pli = "$candidate"
          break
        endif
      end
    endif
  endif
  if ("$fsdb_pli" == "auto" || "$fsdb_pli" == "") then
    echo "ERROR: FSDB PLI was not found under VERDI_HOME or NOVAS_HOME."
    echo "Set FSDB_PLI=/path/to/debpli or FSDB_PLI=builtin."
    exit 2
  endif
  if ("$fsdb_pli" != "builtin") then
    set fsdb_pli_spec = "$fsdb_pli"
    if ("$fsdb_pli_spec" !~ "*:*") then
      set fsdb_pli_spec = "${fsdb_pli_spec}:novas_pli_boot"
    endif
    set fsdb_opts = (-loadpli1 "$fsdb_pli_spec")
    echo "FSDB runtime PLI: $fsdb_pli_spec"
  else
    echo "FSDB runtime PLI: site-integrated/builtin"
  endif
  set fsdb_dir = `dirname "$fsdb_file"`
  mkdir -p "$fsdb_dir"
  set fsdb_plusargs = ( \
    +fsdb_file="$fsdb_file" \
    +fsdb_dump_mda="$fsdb_dump_mda" \
    +fsdb_flush_cycles="$fsdb_flush_cycles" )
  echo "FSDB output: $fsdb_file"
endif

cd "$CORE_ROOT"
exec xrun \
  -64bit \
  -licqueue \
  -R \
  -snapshot "$snapshot" \
  -xmlibdirname "${build_dir}/xcelium.d" \
  $fsdb_opts \
  -sv_lib "$sv_lib" \
  -log "${build_dir}/simulation.log" \
  +elf="$binary" \
  +timeout_cycles="$timeout_cycles" \
  +heartbeat_cycles="$heartbeat_cycles" \
  +elf_verify="$elf_verify" \
  +trace_file="$trace_file" \
  $fsdb_plusargs
