
// Generated by CIRCT firtool-1.75.0
// jeemin.kang : Spike diff 비교용 커밋 로그 출력 모듈 뼈대.
//   input: valid, pc(addr), inst(32b 유효, compressed 가능), wdata[95:0]
//     wdata[31:0]  = rd 값 (정수 rd 결과 또는 CSR 옛값)
//     wdata[63:32] = mem 주소 (load/store) 또는 CSR write operand
//     wdata[95:64] = store 데이터
//   분류: CSR / INT_LOAD / INT_STORE / FP_LOAD / FP_STORE / FP_TO_GPR / FP_TO_FPR
//         만 opcode+funct로 명시적으로 잡고, 나머지(정수 연산/분기/점프 등 +
//         위 분류에 안 걸리는 compressed)는 전부 else로.
//   FP_TO_GPR vs FP_TO_FPR 구분 이유: OP-FP(1010011) opcode를 쓰는 FP 연산기 중
//     FMV.X.W/FCVT.W(U).S/FCLASS/FEQ·FLT·FLE 는 결과를 GPR(rd, x레지스터)에 쓰고,
//     나머지 FP 연산(FADD.S 등)은 FPR(rd, f레지스터)에 쓴다. 목적지 레지스터 종류가
//     달라 print 포맷(x%d vs f%d)이 달라지므로 반드시 구분해야 함.
//   각 분기 내부의 실제 $fwrite/print 문구는 추후 직접 작성 예정 (TODO 표시).

module trace_log (
    input  logic        i_clk,
    input  logic        i_valid,
    input  logic [63:0] i_pc,      // jeemin.kang : 64b 중 하위 32b만 유효 (rv32 전제)
    input  logic [63:0] i_inst,    // jeemin.kang : 64b 중 하위 32b만 유효, compressed(16b) 가능
    input  logic [95:0] i_wdata,   // jeemin.kang : [31:0]=rd, [63:32]=addr/csr wdata, [95:64]=store data
    // jeemin.kang : ecall처럼 exception/interrupt로 커밋되는 명령은 Spike도
    //   1번째 줄(pc/inst)은 그대로 찍고 2번째 줄의 write 필드(x/f/c/mem)만 생략한다.
    //   이전엔 i_valid 자체를 exception/interrupt로 죽였다가 1번째 줄까지 통째로
    //   사라지는 버그가 있었음 (ecall 흔적 자체가 로그에서 없어짐) -> write 필드만 억제로 수정.
    input  logic        i_exception,
    input  logic        i_interrupt
);

    // ---- 편의 wire ----
    wire [31:0] pc   = i_pc[31:0];
    wire [31:0] inst = i_inst[31:0];

    wire        is_c   = (inst[1:0] != 2'b11);           // compressed 여부
    wire [6:0]  opcode = inst[6:0];                        // 32b 명령 opcode
    wire [2:0]  funct3 = inst[14:12];
    wire [6:0]  funct7 = inst[31:25];

    // compressed 쪽 판별용 필드 (quadrant/funct3)
    wire [1:0]  c_op     = inst[1:0];
    wire [2:0]  c_funct3 = inst[15:13];

    // jeemin.kang : CSR 명령어(32b SYSTEM, funct3!=0)는 inst[31:20]이 write/read 대상 CSR 주소(12b).
    //   compressed 쪽엔 CSR 전용 인코딩이 없어 is_csr일 때만 의미 있음.
    wire [11:0] csr_addr = inst[31:20];

    // jeemin.kang : compressed 명령어는 rd 필드 위치가 포맷마다 다른데, 이전엔
    //   전부 inst[11:7](CI/CR 포맷 위치)로 통일해서 읽어 C.OR/C.AND/C.SUB/C.XOR
    //   (CA포맷) 같은 명령에서 dst가 잘못 찍히는 버그가 있었음
    //   (예: 0x8c45 C.OR s0,s1 -> 원래는 x8인데 x24로 잘못 출력됨).
    //   포맷별 rd 위치:
    //     - CL/CIW  (C.LW/C.FLW/C.ADDI4SPN, c_op=00 & c_funct3 000/010/011) : rd = {2'b01, inst[4:2]}  (8~15)
    //     - CA/CB   (C.SRLI/SRAI/ANDI/SUB/XOR/OR/AND, c_op=01 & c_funct3=100) : rd = {2'b01, inst[9:7]} (8~15)
    //     - CJ      (C.JAL, c_op=01 & c_funct3=001) : rd 필드 없음, 암묵적으로 x1
    //     - 나머지(CI/CR: C.ADDI/C.LI/C.LUI/C.SLLI/C.LWSP/C.MV/C.ADD 등) : rd = inst[11:7] (기존과 동일)
    wire is_c_short_rd_42 = is_c && (c_op == 2'b00) &&
        (c_funct3 == 3'b000 || c_funct3 == 3'b010 || c_funct3 == 3'b011); // C.ADDI4SPN/C.LW/C.FLW
    wire is_c_short_rd_97 = is_c && (c_op == 2'b01) && (c_funct3 == 3'b100); // C.SRLI/SRAI/ANDI/SUB/XOR/OR/AND
    wire is_c_jal         = is_c && (c_op == 2'b01) && (c_funct3 == 3'b001); // C.JAL, rd=x1 고정
    // jeemin.kang : C.J(c_op=01,c_funct3=101, CJ포맷)는 rd 필드 자체가 없는 명령인데,
    //   이전엔 이 케이스가 어디에도 안 걸려서 else로 떨어져 inst[11:7](의미없는 필드)을
    //   write처럼 찍는 버그가 있었음 (예: j 800003b6 에서 x15 0x... 가 잘못 붙어나옴).
    //   -> is_branch 와 동일하게 write 자체를 생략하도록 별도 분류.
    wire is_c_j           = is_c && (c_op == 2'b01) && (c_funct3 == 3'b101); // C.J, rd 없음

    // jeemin.kang : c_op=10,c_funct3=100(CR포맷)엔 C.JR/C.JALR/C.MV/C.ADD가 섞여있고
    //   inst[12](funct4 상위비트)와 inst[6:2](rs2 필드)로 구분됨.
    //     - inst[12]=0, inst[6:2]=0 : C.JR rs1   -> write 없음 (rd 필드 아예 없음)
    //     - inst[12]=1, inst[6:2]=0 : C.JALR rs1 -> write 있음, rd=x1 고정
    //     - inst[6:2]!=0            : C.MV/C.ADD -> write 있음, rd=inst[11:7] (기존 else 그대로 맞음)
    //   이전엔 이 구분이 없어 C.JR도 write가 잘못 찍히고, C.JALR도 rd=inst[11:7](실은 rs1 필드)을
    //   잘못 rd로 찍는 문제가 있었음.
    wire is_c_jr   = is_c && (c_op == 2'b10) && (c_funct3 == 3'b100) && !inst[12] && (inst[6:2] == 5'b0); // C.JR, write 없음
    // jeemin.kang : C.JALR과 C.EBREAK(0x9002)는 상위필드(c_funct3=100,inst[12]=1,inst[6:2]=0)가 완전히
    //   동일하고, rs1 필드(inst[11:7])가 0이면 C.EBREAK(스펙상 C.JALR은 rs1!=0 요구)로 예약돼있음.
    //   이 구분이 없어서 C.EBREAK가 C.JALR로 오분류되어 x1에 write가 잘못 찍히는 버그가 있었음.
    wire is_c_jalr = is_c && (c_op == 2'b10) && (c_funct3 == 3'b100) &&  inst[12] && (inst[6:2] == 5'b0) && (inst[11:7] != 5'b0); // C.JALR, rd=x1 고정 (rs1!=0)
    wire is_c_ebreak = is_c && (c_op == 2'b10) && (c_funct3 == 3'b100) && inst[12] && (inst[6:2] == 5'b0) && (inst[11:7] == 5'b0); // C.EBREAK, write 없음

    // jeemin.kang : 32bit SYSTEM opcode 중 funct3==0 인 것(ECALL/EBREAK/MRET/SRET/WFI 등)은
    //   is_csr(funct3!=0)에 안 걸려 전부 else로 떨어져서 x0 0x0 이 잘못 찍히던 문제.
    //   이 명령들은 CSR 접근이 아니라 시스템 명령이라 GPR write가 전혀 없음.
    wire is_sys_nowb = (!is_c && opcode == 7'b1110011 && funct3 == 3'b000); // ECALL/EBREAK/MRET/SRET/WFI 등, write 없음

    // jeemin.kang : FENCE/FENCE.I(opcode=0001111, MISC-MEM)도 rd write가 없는데
    //   이전엔 어디에도 안 걸려 else로 떨어져 x0 0x0 이 잘못 찍히던 문제.
    //   compressed 쪽엔 FENCE 전용 인코딩 없음(C.NOP 계열이 대신 쓰임, 그건 OP-IMM(rd=0)로 이미 처리됨).
    wire is_fence = (!is_c && opcode == 7'b0001111); // FENCE/FENCE.I, write 없음

    wire [4:0] rd_c = (is_c_jal || is_c_jalr) ? 5'd1 :
                      is_c_short_rd_42        ? {2'b01, inst[4:2]} :
                      is_c_short_rd_97        ? {2'b01, inst[9:7]} :
                      inst[11:7];

    // jeemin.kang : x0(rd=0)에 write하는 명령어는 실제로는 항상 0이 쓰이지만,
    //   wdata[31:0]에는 RTL이 그냥 쓰레기값(직전 rf_wdata 등)을 실어 보내서
    //   Spike 로그(x0 0x0)와 diff할 때 값이 안 맞는 문제가 있었음.
    //   GPR(x레지스터)에 쓰는 모든 분기(CSR/INT_LOAD/FP_TO_GPR/else)에서
    //   rd==0이면 무조건 0으로 찍도록 강제한다. (FPR 목적지는 x0 개념이 없어 제외)
    wire [31:0] gpr_wdata = (rd_c == 5'd0) ? 32'h0 : i_wdata[31:0];

    // ---- 분류 조건 (opcode/funct 기반, 32b + compressed 모두 커버) ----
    // jeemin.kang : 아래 조건식은 구조 자리잡기용. 실제 인코딩 세부값은 필요시 보강.

    wire is_csr =
        (!is_c && opcode == 7'b1110011 && funct3 != 3'b000); // SYSTEM, CSRxx (ECALL/EBREAK/xRET 제외)
        // jeemin.kang : compressed 쪽엔 CSR 전용 인코딩 없음

    wire is_int_load =
        (!is_c && opcode == 7'b0000011)  // LOAD (정수)
        || (is_c && c_op == 2'b00 && c_funct3 == 3'b010)   // C.LW
        || (is_c && c_op == 2'b10 && c_funct3 == 3'b010);  // C.LWSP

    wire is_int_store =
        (!is_c && opcode == 7'b0100011)  // STORE (정수)
        || (is_c && c_op == 2'b00 && c_funct3 == 3'b110)   // C.SW
        || (is_c && c_op == 2'b10 && c_funct3 == 3'b110);  // C.SWSP

    wire is_fp_load =
        (!is_c && opcode == 7'b0000111)  // LOAD-FP
        || (is_c && c_op == 2'b00 && (c_funct3 == 3'b001 || c_funct3 == 3'b011))  // C.FLD/C.FLW
        || (is_c && c_op == 2'b10 && (c_funct3 == 3'b001 || c_funct3 == 3'b011)); // C.FLDSP/C.FLWSP

    wire is_fp_store =
        (!is_c && opcode == 7'b0100111)  // STORE-FP
        || (is_c && c_op == 2'b00 && (c_funct3 == 3'b101 || c_funct3 == 3'b111))  // C.FSD/C.FSW
        || (is_c && c_op == 2'b10 && (c_funct3 == 3'b101 || c_funct3 == 3'b111)); // C.FSDSP/C.FSWSP

    // jeemin.kang : OP-FP(1010011) 중 결과를 GPR(x레지스터)에 쓰는 부류만 별도 분류.
    //   FCVT.W(U).S(funct7=1100000), FMV.X.W/FCLASS(funct7=1110000),
    //   FEQ.S/FLT.S/FLE.S(funct7=1010000) 가 여기 해당. (rv32f 기준)
    wire is_fp_to_gpr =
        (!is_c && opcode == 7'b1010011 &&
            (funct7 == 7'b1100000 || funct7 == 7'b1110000 || funct7 == 7'b1010000));

    // jeemin.kang : OP-FP 나머지(FADD.S 등) + FMADD/FMSUB/FNMSUB/FNMADD 는 결과가 FPR(f레지스터)로.
    wire is_fp_to_fpr =
        (!is_c && opcode == 7'b1010011 && !is_fp_to_gpr)  // OP-FP 중 GPR목적지 제외한 나머지
        || (!is_c && (opcode == 7'b1000011 ||   // FMADD
                      opcode == 7'b1000111 ||   // FMSUB
                      opcode == 7'b1001011 ||   // FNMSUB
                      opcode == 7'b1001111));   // FNMADD

    // jeemin.kang : branch(BEQ/BNE/BLT/BGE/BLTU/BGEU, compressed C.BEQZ/C.BNEZ)는 rd write가 없음.
    //   그런데 이전엔 else 분기가 무조건 x%0d ... 를 찍어서, branch의 inst[11:7](실은 rs2 필드)를
    //   rd처럼 잘못 출력하는 문제가 있었음 (예: bnez s6,... 에서 x18 0x0 이 잘못 붙어나옴).
    //   -> is_branch 추가해서 else에서 write 출력 자체를 건너뛰도록 분리.
    wire is_branch =
        (!is_c && opcode == 7'b1100011)  // BEQ/BNE/BLT/BGE/BLTU/BGEU
        || (is_c && c_op == 2'b01 && (c_funct3 == 3'b110 || c_funct3 == 3'b111)); // C.BEQZ/C.BNEZ

    // jeemin.kang : exception/interrupt로 커밋된 명령은 write 필드를 찍으면 안 됨
    //   (그 사이클의 wdata는 실제로 rd에 반영된 값이 아니라 트랩 전 상태의 쓰레기값일 수 있음).
    wire suppress_wb = i_exception || i_interrupt;

    // ---- 출력 ----
    integer trace_fd;
    
    initial begin
        trace_fd = $fopen("trace_log.out", "w");
        if (trace_fd == 0) begin
            $display("ERROR: Cannot open trace_log.out");
            $finish;
        end
    end
    
    final begin
        $fclose(trace_fd);
    end
    
    always @(posedge i_clk) begin
       if (i_valid) begin
         $fwrite(trace_fd,"core   %0d: 0x%08x (0x%08x)\n",0,pc, inst);
         $fwrite(trace_fd,"core   %0d: %0d 0x%08x (0x%08x)",0,3,pc, inst);
          if (suppress_wb) begin
             // jeemin.kang : exception/interrupt 커밋 -> write 필드 생략 (1 번째 줄은 위에서 이미 찍음)
          end
          else if (is_csr) begin  // (jeemin.kang) : CSR 명령어 print (csr_addr 사용)
             $fwrite(trace_fd," x%0d 0x%08x c%0d 0x%08x",rd_c, gpr_wdata, csr_addr, i_wdata[63:32]); // jeemin.kang : rd_c 포맷별 보정 + rd==0 -> gpr_wdata=0
          end
          else if (is_int_load) begin// (jeemin.kang) : 정수 LOAD 명령어 print
             $fwrite(trace_fd," x%0d 0x%08x mem 0x%08x",rd_c, gpr_wdata, i_wdata[63:32]); // jeemin.kang : rd_c 포맷별 보정 + rd==0 -> gpr_wdata=0
          end
          else if (is_int_store) begin // (jeemin.kang) : 정수 STORE 명령어 print
             $fwrite(trace_fd," mem 0x%08x 0x%08x",i_wdata[63:32], i_wdata[95:64]); // jeemin.kang : store 는 rd 없어 x0 이슈 무관
          end
          else if (is_fp_load) begin// (jeemin.kang) : FP LOAD 명령어 print
             $fwrite(trace_fd," f%0d 0x%08x mem 0x%08x",rd_c, i_wdata[31:0], i_wdata[63:32]); // jeemin.kang : C.FLW 도 rd_c 로 포맷별 보정 (FPR 목적지, x0 강제규칙 없음)
          end
          else if (is_fp_store) begin
             // jeemin.kang : 임시 구현. mem 주소 (wdata[63:32])는 정수 store 와 동일 신호 (wb_reg_wdata) 라 정확함.
             //   단 store 데이터 (wdata[95:64]=wb_reg_rs2) 는 FP store 실제 경로 (io.fpu.store_data) 가 아니라
             //   아직 안 실려있는 값이므로 신뢰 불가 - 지금은 자리만 채워둔 TEMP 값. FP store data 배선 후 교체 필요.
             $fwrite(trace_fd," mem 0x%08x 0x%08x /*TEMP:fp store data unverified*/",i_wdata[63:32], i_wdata[95:64]);
          end
          else if (is_fp_to_gpr) begin// (jeemin.kang) : FP 연산기 중 목적지가 GPR 인 경우 print (FMV.X.W 등)
             $fwrite(trace_fd," x%0d 0x%08x ",rd_c, gpr_wdata); // jeemin.kang : rd_c 포맷별 보정 + rd==0 -> gpr_wdata=0
          end
          else if (is_fp_to_fpr) begin // (jeemin.kang) : FP 연산기 중 목적지가 FPR 인 경우 print (FADD.S 등)
             $fwrite(trace_fd," f%0d 0x%08x ",rd_c, i_wdata[31:0]); // jeemin.kang : rd_c 포맷별 보정 (FPR 목적지, x0 이슈 무관)
          end
          else if (is_branch || is_c_j || is_c_jr || is_c_ebreak || is_sys_nowb || is_fence) begin
             // jeemin.kang : branch(BEQ/BNE/.../C.BEQZ/C.BNEZ), C.J, C.JR, C.EBREAK,
             //   32bit ECALL/EBREAK/MRET/SRET/WFI(funct3==0 SYSTEM), FENCE/FENCE.I
             //   는 rd write 가 없으므로 write 필드 자체를 출력하지 않음
          end
          else begin// (jeemin.kang) : 나머지 전부 (정수 연산/점프 등 + 위 분류에 안 걸리는 compressed) print
             $fwrite(trace_fd," x%0d 0x%08x ",rd_c, gpr_wdata); // jeemin.kang : rd_c 포맷별 보정 (C.OR/AND/XOR/SUB 등) + rd==0 -> gpr_wdata=0
          end
          $fwrite(trace_fd,"\n");
      end
   end

endmodule
